[Unit]
Description=Collect SMART and btrfs scrub data for rigtop
Documentation=https://github.com/akivajp/rigtop

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/rigtop-collect
# Creates /var/lib/rigtop/{smart,btrfs}; with ProtectSystem=strict these are
# the only writable places.
StateDirectory=rigtop/smart rigtop/btrfs
StateDirectoryMode=0755
# smartctl needs raw device access, so no PrivateDevices=; restrict the rest.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
