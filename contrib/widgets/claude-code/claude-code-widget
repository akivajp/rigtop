#!/usr/bin/env python3
"""rigtop widget: running Claude Code sessions, their active subagents and
the subscription usage limits (5-hour and weekly windows).

Prints the JSON rows rigtop's [[widgets]] understand. Uses only the Python
standard library. Sources, from most to least stable:

- sessions: `claude agents --json` (documented); falls back to
  ~/.claude/sessions/*.json (undocumented) when `claude` is not on the PATH
- subagents: ~/.claude/projects/<project>/<session>/subagents/ (the path is
  documented, the file contents are not); a subagent counts as active while
  its transcript changed in the last ACTIVE_SECS seconds
- usage limits: the status endpoint of claude-spillway when it runs (a
  proxy that already reads them from Anthropic's responses), else the
  `rate_limits` Claude Code passes to the status line, saved by the
  companion `statusline-save-limits` (see README.md)

Claude Code's files are internal and may change between versions; this
script degrades to fewer rows instead of failing.
"""

import glob
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request
from datetime import datetime

HOME = os.path.expanduser("~")
CLAUDE_DIR = os.environ.get("CLAUDE_CONFIG_DIR", os.path.join(HOME, ".claude"))
CACHE_DIR = os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache"))
LIMITS_FILE = os.path.join(CACHE_DIR, "rigtop", "claude-rate-limits.json")
# claude-spillway's status endpoint; "" to skip it.
SPILLWAY_URL = os.environ.get(
    "RIGTOP_CLAUDE_SPILLWAY_URL", "http://127.0.0.1:8787/_spillway/status"
)
# A subagent whose transcript changed this recently is shown as active.
ACTIVE_SECS = int(os.environ.get("RIGTOP_CLAUDE_ACTIVE_SECS", "120"))
# Usage data older than this is marked as such (it updates only while a
# session talks to the API).
STALE_LIMITS_SECS = 15 * 60
# "remaining" (100% when unused) or "used".
QUOTA_MODE = os.environ.get("RIGTOP_CLAUDE_QUOTA", "remaining")
# An idle session waiting for you longer than this is greyed out.
QUIET_SECS = 60 * 60

WINDOWS = (("five_hour", "5h"), ("seven_day", "week"))


def row(value="", label="", **extra):
    return {"label": label, "value": value, **extra}


def find_claude():
    found = shutil.which("claude")
    if found:
        return found
    # Non-interactive shells (e.g. over ssh) often lack ~/.local/bin.
    local = os.path.join(HOME, ".local", "bin", "claude")
    return local if os.access(local, os.X_OK) else None


def sessions():
    claude = find_claude()
    if claude:
        try:
            out = subprocess.run(
                [claude, "agents", "--json"],
                capture_output=True,
                text=True,
                timeout=10,
            )
            data = json.loads(out.stdout)
            if isinstance(data, list):
                return data
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
    # Fallback: one file per session, left behind when a process dies.
    found = []
    for path in glob.glob(os.path.join(CLAUDE_DIR, "sessions", "*.json")):
        try:
            with open(path, encoding="utf-8") as f:
                data = json.load(f)
            os.kill(int(data["pid"]), 0)
        except (OSError, ValueError, KeyError, TypeError):
            continue
        found.append(data)
    return found


def project_dir(cwd):
    # Claude Code names project directories after the working directory,
    # with every non-alphanumeric character replaced by "-".
    return re.sub(r"[^A-Za-z0-9]", "-", cwd)


def active_subagents(session, now):
    directory = os.path.join(
        CLAUDE_DIR,
        "projects",
        project_dir(session.get("cwd", "")),
        session.get("sessionId", ""),
        "subagents",
    )
    active = []
    for meta_path in glob.glob(os.path.join(directory, "*.meta.json")):
        transcript = meta_path[: -len(".meta.json")] + ".jsonl"
        try:
            age = now - os.path.getmtime(transcript)
            with open(meta_path, encoding="utf-8") as f:
                meta = json.load(f)
        except (OSError, ValueError):
            continue
        if age <= ACTIVE_SECS:
            active.append((age, meta.get("agentType", "agent"), meta.get("description", "")))
    return sorted(active)


def reset_text(epoch, now):
    when = datetime.fromtimestamp(epoch)
    if when.date() == datetime.fromtimestamp(now).date():
        return when.strftime("%H:%M")
    return when.strftime("%a %H:%M")


def window_row(label, used, resets, now):
    """A usage window: `used` in percent, `resets` in epoch seconds. Shown
    as what is left (a full bar when unused) unless QUOTA_MODE is "used"."""
    if resets is not None and resets <= now:
        # The window has rolled over since the data was read.
        return row("reset (no newer data)", label=label, level="dim")
    left = 100 - used
    level = "bad" if left <= 10 else "warn" if left <= 30 else "ok"
    # The time is when the window resets ("resets" left out to fit).
    when = f" · {reset_text(resets, now)}" if resets else ""
    if QUOTA_MODE == "used":
        gauge = max(0.0, min(1.0, used / 100))
        return row(f"{used:.0f}% used{when}", label=label, gauge=gauge, level=level)
    gauge = max(0.0, min(1.0, left / 100))
    return row(
        f"{left:.0f}% left{when}", label=label, gauge=gauge, gauge_style="level", level=level
    )


def spillway_rows(now):
    """Usage from claude-spillway, or None when it is not running."""
    if not SPILLWAY_URL:
        return None
    try:
        with urllib.request.urlopen(SPILLWAY_URL, timeout=1) as response:
            status = json.load(response)
        anthropic = status["anthropic"]
    except (OSError, ValueError, KeyError, TypeError):
        return None
    rows = []
    for key, label in (("5h", "5h"), ("7d", "week")):
        used = anthropic.get(f"utilization_{key}")
        if isinstance(used, (int, float)):
            rows.append(window_row(label, used * 100, anthropic.get(f"reset_{key}"), now))
    if not rows:
        return None
    observed = anthropic.get("observed_at") or now
    if now - observed > STALE_LIMITS_SECS:
        rows.append(row(f"as of {reset_text(observed, now)}", level="dim"))
    # Spilled over to Ollama: say so, with Ollama's own usage.
    mode = status.get("mode")
    if mode and mode != "anthropic":
        rows.append(row(f"{mode}: {status.get('reason') or 'spilled over'}", label="route", level="warn"))
    ollama = status.get("ollama") or {}
    windows = [
        ("session", ollama.get("session_utilization"), ollama.get("session_reset")),
        ("week", ollama.get("weekly_utilization"), ollama.get("weekly_reset")),
    ]
    if any(isinstance(used, (int, float)) for _, used, _ in windows):
        rows.append(row("Ollama", heading=True))
        for label, used, resets in windows:
            if isinstance(used, (int, float)):
                rows.append(window_row(label, used * 100, resets, now))
    return rows


def limit_rows(now):
    from_spillway = spillway_rows(now)
    if from_spillway is not None:
        return from_spillway
    try:
        with open(LIMITS_FILE, encoding="utf-8") as f:
            saved = json.load(f)
        limits = saved["rate_limits"]
        saved_at = float(saved.get("saved_at", 0))
    except (OSError, ValueError, KeyError, TypeError):
        return [row("usage: set up statusline-save-limits", label="limits", level="dim")]
    rows = []
    for key, label in WINDOWS:
        window = limits.get(key)
        if not isinstance(window, dict):
            continue
        try:
            used = float(window["used_percentage"])
            resets = float(window["resets_at"])
        except (KeyError, TypeError, ValueError):
            continue
        rows.append(window_row(label, used, resets, now))
    if rows and now - saved_at > STALE_LIMITS_SECS:
        rows.append(row(f"as of {reset_text(saved_at, now)}", label="", level="dim"))
    return rows or [row("usage: no data yet", label="limits", level="dim")]


def duration(secs):
    secs = max(0, int(secs))
    if secs < 60:
        return f"{secs}s"
    if secs < 3600:
        return f"{secs // 60}m"
    if secs < 86400:
        return f"{secs // 3600}h{secs % 3600 // 60:02d}m"
    return f"{secs // 86400}d"


def status_since(session):
    """When the session's status last changed (epoch seconds), from its
    file in ~/.claude/sessions/ (undocumented)."""
    try:
        path = os.path.join(CLAUDE_DIR, "sessions", f"{int(session['pid'])}.json")
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        if data.get("status") != session.get("status"):
            return None
        return float(data["statusUpdatedAt"]) / 1000
    except (OSError, ValueError, KeyError, TypeError):
        return None


def running_commands(pid):
    """Commands the session's Bash tool is running: its descendant shells
    started through ~/.claude/shell-snapshots/. None where /proc is missing."""
    if not os.path.isdir("/proc"):
        return None
    marker = os.path.join(CLAUDE_DIR, "shell-snapshots") + os.sep
    count, stack, seen = 0, [pid], set()
    while stack:
        current = stack.pop()
        for children in glob.glob(f"/proc/{current}/task/*/children"):
            try:
                with open(children) as f:
                    stack.extend(int(c) for c in f.read().split() if int(c) not in seen)
            except (OSError, ValueError):
                continue
        if current == pid:
            continue
        seen.add(current)
        try:
            with open(f"/proc/{current}/cmdline", "rb") as f:
                if marker.encode() in f.read():
                    count += 1
        except OSError:
            pass
    return count


def short_name(session):
    """The session name without its project's name, which the heading
    already shows ("rigtop-06" under "rigtop" becomes "06")."""
    name = session.get("name") or "main"
    project = os.path.basename(session.get("cwd", "").rstrip("/\\"))
    if project and name.startswith(project + "-") and len(name) > len(project) + 1:
        return name[len(project) + 1 :]
    return name


def session_line(session, agents, now):
    """(label, text, level) for a session: what it is doing, and for an
    idle one how long and whether it waits for you or for background work."""
    status = session.get("status", "?")
    name = short_name(session)
    since = status_since(session)
    elapsed = f" · {duration(now - since)}" if since else ""
    if status == "busy":
        extra = f" · {len(agents)} agent{'s' if len(agents) != 1 else ''}" if agents else ""
        return status, f"{name}{extra}", "ok"
    if status == "waiting":
        what = session.get("waitingFor") or "you"
        return status, f"{name} · needs {what}{elapsed}", "warn"
    if status == "idle":
        commands = running_commands(int(session.get("pid", 0) or 0)) or 0
        pending = []
        if commands:
            pending.append(f"{commands} task{'s' if commands != 1 else ''}")
        if agents:
            pending.append(f"{len(agents)} agent{'s' if len(agents) != 1 else ''}")
        if pending:
            # Its turn ended, but background work it started still runs.
            return status, f"{name} · waiting on {', '.join(pending)}{elapsed}", "ok"
        quiet = since is not None and now - since > QUIET_SECS
        return status, f"{name} · your turn{elapsed}", "dim" if quiet else "normal"
    return status, name, "normal"


def session_rows(now):
    found = sessions()
    if not found:
        return [row("no running sessions", level="dim")]
    rows = []
    previous = None
    for session in sorted(found, key=lambda s: (s.get("cwd", ""), s.get("startedAt", 0))):
        # One heading per project, its sessions under it.
        cwd = session.get("cwd", "")
        if cwd != previous:
            rows.append(row(os.path.basename(cwd.rstrip("/\\")) or "?", heading=True))
            previous = cwd
        agents = active_subagents(session, now)
        label, text, level = session_line(session, agents, now)
        rows.append(row(text, label=label, level=level))
        for age, kind, description in agents:
            text = f"{kind}: {description}" if description else kind
            rows.append(row(text, label="  agent", level="normal" if age < 30 else "dim"))
    return rows


def main():
    now = time.time()
    rows = limit_rows(now) + session_rows(now)
    json.dump({"rows": rows}, sys.stdout, ensure_ascii=False)
    print()


if __name__ == "__main__":
    main()
