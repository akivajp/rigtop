#!/usr/bin/env python3
"""rigtop widget: running Claude Code sessions, their active subagents and
the subscription usage limits (5-hour and weekly windows, and the weekly
Fable limit), per Claude account when several are in use.

Prints the JSON rows rigtop's [[widgets]] understand. Uses only the Python
standard library. Sources, from most to least stable:

- sessions: `claude agents --json` (documented); falls back to
  ~/.claude/sessions/*.json (undocumented) when `claude` is not on the PATH
- subagents: ~/.claude/projects/<project>/<session>/subagents/ (the path is
  documented, the file contents are not); a subagent counts as active while
  its transcript changed in the last ACTIVE_SECS seconds
- context window use: the token counts of the last reply in the session's
  transcript, ~/.claude/projects/<project>/<session>.jsonl (undocumented),
  against the model's context window (1M for current Claude models and
  "[1m]" ones, 200K for older Claude models)
- usage limits: the status endpoint of claude-spillway when it runs (a
  proxy that already reads them from Anthropic's responses, for each Claude
  account that goes through it), else the `rate_limits` Claude Code passes
  to the status line, saved by the companion `statusline-save-limits` (see
  README.md)
- accounts: Claude Code keeps one configuration directory per signed-in
  account (CLAUDE_CONFIG_DIR). The directories come from
  RIGTOP_CLAUDE_CONFIG_DIRS, else from `accounts.profiles` in
  claude-spillway's configuration file, else it is ~/.claude alone

Claude Code's files are internal and may change between versions; this
script degrades to fewer rows instead of failing.
"""

import glob
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request
from datetime import datetime

HOME = os.path.expanduser("~")
CLAUDE_DIR = os.environ.get("CLAUDE_CONFIG_DIR", os.path.join(HOME, ".claude"))
CACHE_DIR = os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache"))
LIMITS_FILE = os.path.join(CACHE_DIR, "rigtop", "claude-rate-limits.json")
# claude-spillway's status endpoint; "" to skip it.
SPILLWAY_URL = os.environ.get(
    "RIGTOP_CLAUDE_SPILLWAY_URL", "http://127.0.0.1:8787/_spillway/status"
)
# Claude Code's configuration directories, one per account, separated like
# PATH; an entry may name its account, `work=~/.claude-profiles/work`. Unset:
# CLAUDE_CONFIG_DIR alone when that is set, else the profiles in
# claude-spillway's configuration, else ~/.claude.
CONFIG_DIRS = os.environ.get("RIGTOP_CLAUDE_CONFIG_DIRS")
# claude-spillway's configuration file, for the accounts' directories.
SPILLWAY_CONFIG = os.environ.get("CLAUDE_SPILLWAY_CONFIG") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"),
    "claude-spillway",
    "config.yaml",
)
# With several Claude accounts behind claude-spillway: "all" shows the limits
# of each, "current" only those of the account used most recently.
ACCOUNTS_MODE = os.environ.get("RIGTOP_CLAUDE_ACCOUNTS", "all")
# A subagent whose transcript changed this recently is shown as active.
ACTIVE_SECS = int(os.environ.get("RIGTOP_CLAUDE_ACTIVE_SECS", "120"))
# Usage data older than this is marked as such (it updates only while a
# session talks to the API).
STALE_LIMITS_SECS = 15 * 60
# "remaining" (100% when unused) or "used".
QUOTA_MODE = os.environ.get("RIGTOP_CLAUDE_QUOTA", "remaining")
# How a window's reset is shown: "remaining" (the time until then, `4h23m`)
# or "clock" (the time of day, `03:40`, with the weekday beyond a day).
RESET_MODE = os.environ.get("RIGTOP_CLAUDE_RESET", "remaining")
# A session waiting for you is yellow for this long, then grey...
FRESH_SECS = int(os.environ.get("RIGTOP_CLAUDE_FRESH_SECS", str(60 * 60)))
# ...and left out (counted on one line) after this long; 0 keeps it.
HIDE_SECS = int(os.environ.get("RIGTOP_CLAUDE_HIDE_SECS", str(2 * 60 * 60)))

WINDOWS = (("five_hour", "5h"), ("seven_day", "week"))

# Context windows (tokens). Current models have 1M; older Claude models 200K.
LARGE_CONTEXT = re.compile(
    r"\[1m\]|claude-(fable|mythos|opus-(5|4-[678])|sonnet-(5|4-6)|haiku-5)"
)
LARGE_WINDOW = 1_000_000
SMALL_WINDOW = 200_000
# Forces the window for every session, e.g. 1000000 ("" to infer it).
CONTEXT_WINDOW = os.environ.get("RIGTOP_CLAUDE_CONTEXT_WINDOW", "")
# How much of the end of a transcript to read for its last reply.
TAIL_BYTES = 512 * 1024
# Context use from which the row turns yellow, then red (fractions).
CONTEXT_WARN, CONTEXT_FULL = 0.7, 0.9


# Labels are indented like a tree under the project's name: a session's
# status by one column, its context and subagents by three. rigtop's label
# column is 8 characters wide, which " waiting" and "   agent" just fill.
STATUS_INDENT = " "
CHILD_INDENT = "   "


def row(value="", label="", **extra):
    return {"label": label, "value": value, **extra}


def find_claude():
    found = shutil.which("claude")
    if found:
        return found
    # Non-interactive shells (e.g. over ssh) often lack ~/.local/bin.
    local = os.path.join(HOME, ".local", "bin", "claude")
    return local if os.access(local, os.X_OK) else None


def spillway_profiles():
    """(name, directory) of the accounts in claude-spillway's configuration:
    the `name` and `config_dir` of the items under its top-level `accounts`.
    Read line by line, as the standard library has no YAML parser."""
    try:
        with open(SPILLWAY_CONFIG, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except (OSError, ValueError):
        return []
    items, inside = [], False
    for line in lines:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if not line[0].isspace():
            inside = line.startswith("accounts:")
            continue
        if not inside:
            continue
        found = re.match(r"\s*(-\s*)?(name|config_dir)\s*:\s*(.*?)\s*(#.*)?$", line)
        if line.lstrip().startswith("-"):
            items.append({})
        if found and items and found.group(3):
            items[-1][found.group(2)] = found.group(3).strip("'\"")
    return [(item.get("name"), item["config_dir"]) for item in items if "config_dir" in item]


def config_dirs():
    """[(account name or None, directory)] of the Claude Code configuration
    directories to read sessions from."""
    if CONFIG_DIRS is not None:
        listed = []
        for entry in CONFIG_DIRS.split(os.pathsep):
            name, named, path = entry.partition("=")
            if entry:
                listed.append((name, path) if named else (None, entry))
    elif "CLAUDE_CONFIG_DIR" in os.environ:
        listed = []
    else:
        listed = spillway_profiles()
    found, seen = [], set()
    for name, path in listed:
        path = os.path.expanduser(path)
        real = os.path.realpath(path)
        if real not in seen and os.path.isdir(path):
            seen.add(real)
            found.append((name, path))
    return found or [(None, CLAUDE_DIR)]


def claude_dir(session):
    """The configuration directory the session was found in."""
    return session.get("_dir") or CLAUDE_DIR


def sessions_in(directory, claude):
    if claude:
        # `claude` lists the sessions of one configuration directory.
        env = dict(os.environ)
        if os.path.realpath(directory) == os.path.realpath(os.path.join(HOME, ".claude")):
            env.pop("CLAUDE_CONFIG_DIR", None)
        else:
            env["CLAUDE_CONFIG_DIR"] = directory
        try:
            out = subprocess.run(
                [claude, "agents", "--json"],
                capture_output=True,
                text=True,
                timeout=10,
                env=env,
            )
            data = json.loads(out.stdout)
            if isinstance(data, list):
                return [item for item in data if isinstance(item, dict)]
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
    # Fallback: one file per session, left behind when a process dies.
    found = []
    for path in glob.glob(os.path.join(directory, "sessions", "*.json")):
        try:
            with open(path, encoding="utf-8") as f:
                data = json.load(f)
            os.kill(int(data["pid"]), 0)
        except (OSError, ValueError, KeyError, TypeError):
            continue
        found.append(data)
    return found


def sessions():
    """The running sessions of every configuration directory, each with the
    directory it came from (`_dir`) and, with several directories, the
    account's name (`_account`)."""
    claude = find_claude()
    directories = config_dirs()
    found, seen = [], set()
    for name, directory in directories:
        for session in sessions_in(directory, claude):
            key = session.get("pid") or session.get("sessionId")
            if key in seen:
                continue
            seen.add(key)
            session["_dir"] = directory
            if len(directories) > 1:
                session["_account"] = name or os.path.basename(directory.rstrip("/\\"))
            found.append(session)
    return found


def project_dir(cwd):
    # Claude Code names project directories after the working directory,
    # with every non-alphanumeric character replaced by "-".
    return re.sub(r"[^A-Za-z0-9]", "-", cwd)


def active_subagents(session, now):
    directory = os.path.join(
        claude_dir(session),
        "projects",
        project_dir(session.get("cwd", "")),
        session.get("sessionId", ""),
        "subagents",
    )
    active = []
    for meta_path in glob.glob(os.path.join(directory, "*.meta.json")):
        transcript = meta_path[: -len(".meta.json")] + ".jsonl"
        try:
            age = now - os.path.getmtime(transcript)
            with open(meta_path, encoding="utf-8") as f:
                meta = json.load(f)
        except (OSError, ValueError):
            continue
        if age <= ACTIVE_SECS:
            active.append((age, meta.get("agentType", "agent"), meta.get("description", "")))
    return sorted(active)


def reset_text(epoch, now):
    when = datetime.fromtimestamp(epoch)
    # Within a day the time alone says which day it is (so the five-hour
    # window never shows a weekday, even when it resets after midnight).
    if abs(epoch - now) < 24 * 3600:
        return when.strftime("%H:%M")
    return when.strftime("%a %H:%M")


def remaining_text(secs):
    """The time until a reset, short enough for the weekly window to fit:
    `23m`, `4h23m`, and days and hours from a day on (`6d15h`), where the
    minutes no longer matter. Rounded up, so it never reads `0m`."""
    minutes = max(1, -(-int(secs) // 60))
    hours, minutes = divmod(minutes, 60)
    if hours >= 24:
        return f"{hours // 24}d{hours % 24:02d}h"
    if hours:
        return f"{hours}h{minutes:02d}m"
    return f"{minutes}m"


def window_row(label, used, resets, now, note=""):
    """A usage window: `used` in percent, `resets` in epoch seconds. Shown
    as what is left (a full bar when unused) unless QUOTA_MODE is "used".
    `note` is added to the row's hint."""
    if resets is not None and resets <= now:
        # The window has rolled over since the data was read.
        return row("reset (no newer data)", label=label, level="dim")
    left = 100 - used
    level = "bad" if left <= 10 else "warn" if left <= 30 else "ok"
    # The time until the window resets, or when it does ("resets" left
    # out to fit).
    # The other of the two goes in the hint (rigtop's GUI shows it when
    # the pointer rests on the row).
    extra = {}
    if not resets:
        when = ""
    elif RESET_MODE == "clock":
        when = f" · {reset_text(resets, now)}"
        extra["hint"] = f"resets in {remaining_text(resets - now)}"
    else:
        when = f" · {remaining_text(resets - now)}"
        extra["hint"] = datetime.fromtimestamp(resets).strftime("resets %a %Y-%m-%d %H:%M")
    if note:
        extra["hint"] = f"{extra['hint']} · {note}" if "hint" in extra else note
    if QUOTA_MODE == "used":
        gauge = max(0.0, min(1.0, used / 100))
        return row(f"{used:.0f}% used{when}", label=label, gauge=gauge, level=level, **extra)
    gauge = max(0.0, min(1.0, left / 100))
    return row(
        f"{left:.0f}% left{when}",
        label=label,
        gauge=gauge,
        gauge_style="level",
        level=level,
        **extra,
    )


def account_rows(anthropic, now, indent=""):
    """The usage windows of one Claude account, from claude-spillway's
    reading of it: the 5-hour and weekly windows, and the weekly limit of
    Fable alone where the account has used Fable."""
    rows = []
    for key, label in (("5h", "5h"), ("7d", "week"), ("7d_fable", "fable")):
        used = anthropic.get(f"utilization_{key}")
        if not isinstance(used, (int, float)):
            continue
        note = ""
        if key == "7d_fable":
            # Anthropic reports it only on replies to Fable requests, so it
            # can be older than the other two.
            note = "weekly limit of Fable alone"
            read = anthropic.get("observed_at_7d_fable")
            if isinstance(read, (int, float)):
                note += f", as of {reset_text(read, now)}"
        rows.append(window_row(indent + label, used * 100, anthropic.get(f"reset_{key}"), now, note))
    return rows


def route_row(status, indent=""):
    """Spilled over to Ollama: say so. None while on Anthropic."""
    mode = status.get("mode")
    if not mode or mode == "anthropic":
        return None
    text = f"{mode}: {status.get('reason') or 'spilled over'}"
    return row(text, label=indent + "route", level="warn")


def stale_text(anthropic, now):
    """`as of 08:19` for a reading too old to pass for the current state."""
    observed = anthropic.get("observed_at") or now
    if now - observed > STALE_LIMITS_SECS:
        return f"as of {reset_text(observed, now)}"
    return ""


def spillway_rows(now):
    """Usage from claude-spillway, or None when it is not running."""
    if not SPILLWAY_URL:
        return None
    try:
        with urllib.request.urlopen(SPILLWAY_URL, timeout=1) as response:
            status = json.load(response)
        anthropic = status["anthropic"]
        accounts = [
            account
            for account in status.get("accounts") or []
            if isinstance(account, dict) and isinstance(account.get("anthropic"), dict)
        ]
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return None
    rows = []
    several = ACCOUNTS_MODE != "current" and len(accounts) > 1
    if several:
        # Each account under its name, in the color of its tightest window.
        severity = {"ok": 0, "dim": 0, "warn": 1, "bad": 2}
        for account in accounts:
            windows = account_rows(account["anthropic"], now, STATUS_INDENT)
            if not windows:
                continue
            name = account.get("name") or account.get("label") or "?"
            stale = stale_text(account["anthropic"], now)
            level = max((w.get("level", "ok") for w in windows), key=lambda l: severity.get(l, 0))
            rows.append(row(f"{name} · {stale}" if stale else name, heading=True, level=level))
            rows.extend(windows)
            route = route_row(account, STATUS_INDENT)
            if route:
                rows.append(route)
    else:
        # The top level describes the account used most recently.
        rows = account_rows(anthropic, now)
        stale = stale_text(anthropic, now)
        if rows and stale:
            rows.append(row(stale, level="dim"))
        route = route_row(status)
        if rows and route:
            rows.append(route)
    if not rows:
        return None
    indent = STATUS_INDENT if several else ""
    ollama = status.get("ollama") or {}
    windows = [
        ("session", ollama.get("session_utilization"), ollama.get("session_reset")),
        ("week", ollama.get("weekly_utilization"), ollama.get("weekly_reset")),
    ]
    if any(isinstance(used, (int, float)) for _, used, _ in windows):
        rows.append(row("Ollama", heading=True))
        for label, used, resets in windows:
            if isinstance(used, (int, float)):
                rows.append(window_row(indent + label, used * 100, resets, now))
    return rows


def limit_rows(now):
    from_spillway = spillway_rows(now)
    if from_spillway is not None:
        return from_spillway
    try:
        with open(LIMITS_FILE, encoding="utf-8") as f:
            saved = json.load(f)
        limits = saved["rate_limits"]
        saved_at = float(saved.get("saved_at", 0))
    except (OSError, ValueError, KeyError, TypeError):
        return [row("usage: set up statusline-save-limits", label="limits", level="dim")]
    rows = []
    for key, label in WINDOWS:
        window = limits.get(key)
        if not isinstance(window, dict):
            continue
        try:
            used = float(window["used_percentage"])
            resets = float(window["resets_at"])
        except (KeyError, TypeError, ValueError):
            continue
        rows.append(window_row(label, used, resets, now))
    if rows and now - saved_at > STALE_LIMITS_SECS:
        rows.append(row(f"as of {reset_text(saved_at, now)}", label="", level="dim"))
    return rows or [row("usage: no data yet", label="limits", level="dim")]


def context_window(model, used):
    """The context window of `model` in tokens, or None when unknown (not a
    Claude model). A window smaller than what is used must be wrong."""
    if CONTEXT_WINDOW.isdigit():
        return int(CONTEXT_WINDOW)
    if LARGE_CONTEXT.search(model):
        return LARGE_WINDOW
    if model.startswith("claude-"):
        return SMALL_WINDOW if used <= SMALL_WINDOW else LARGE_WINDOW
    return None


def context_use(session):
    """(tokens in the context, model) from the end of the session's
    transcript: the input of its last reply, or the size left by a
    compaction after it. None when unknown."""
    path = os.path.join(
        claude_dir(session),
        "projects",
        project_dir(session.get("cwd", "")),
        session.get("sessionId", "") + ".jsonl",
    )
    try:
        with open(path, "rb") as f:
            size = f.seek(0, os.SEEK_END)
            f.seek(max(0, size - TAIL_BYTES))
            tail = f.read().decode("utf-8", errors="replace")
    except OSError:
        return None
    lines = tail.splitlines()
    if size > TAIL_BYTES:
        lines = lines[1:]  # the first line is cut
    compacted = None
    for line in reversed(lines):
        if '"compact_boundary"' in line and compacted is None:
            try:
                compacted = int(json.loads(line)["compactMetadata"]["postTokens"])
            except (ValueError, KeyError, TypeError):
                pass
            continue
        if '"usage"' not in line:
            continue
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        message = entry.get("message") or {}
        model = entry.get("requestedModel") or message.get("model") or ""
        usage = message.get("usage") or {}
        if entry.get("type") != "assistant" or entry.get("isSidechain") or model == "<synthetic>":
            continue
        used = sum(
            int(usage.get(key) or 0)
            for key in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens")
        )
        if used == 0:
            continue
        return (compacted if compacted is not None else used), model
    return None


def tokens(count):
    if count >= 1_000_000 and count % 1_000_000 == 0:
        return f"{count // 1_000_000}M"
    if count >= 1_000_000:
        return f"{count / 1_000_000:.1f}M"
    if count >= 1000:
        return f"{count // 1000}K"
    return str(count)


def context_row(session, level):
    """How full the session's context window is, as a gauge row in the
    session's `level`, yellow or red instead when it fills up."""
    found = context_use(session)
    if not found:
        return None
    session_level = level
    used, model = found
    window = context_window(model, used)
    if not window:
        return row(f"{tokens(used)} tokens", label=CHILD_INDENT + "ctx", level=level, label_level=level)
    fraction = min(used / window, 1.0)
    if fraction >= CONTEXT_FULL:
        level = "bad"
    elif fraction >= CONTEXT_WARN:
        level = "warn"
    return row(
        f"{fraction * 100:.0f}% · {tokens(used)}/{tokens(window)}",
        label=CHILD_INDENT + "ctx",
        label_level=session_level,
        gauge=round(fraction, 3),
        gauge_style="level",
        level=level,
    )


def duration(secs):
    secs = max(0, int(secs))
    if secs < 60:
        return f"{secs}s"
    if secs < 3600:
        return f"{secs // 60}m"
    if secs < 86400:
        minutes = secs % 3600 // 60
        return f"{secs // 3600}h{minutes:02d}m" if minutes else f"{secs // 3600}h"
    return f"{secs // 86400}d"


def status_since(session):
    """When the session's status last changed (epoch seconds), from its
    file in ~/.claude/sessions/ (undocumented)."""
    try:
        path = os.path.join(claude_dir(session), "sessions", f"{int(session['pid'])}.json")
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        if data.get("status") != session.get("status"):
            return None
        return float(data["statusUpdatedAt"]) / 1000
    except (OSError, ValueError, KeyError, TypeError):
        return None


def running_commands(session):
    """Commands the session's Bash tool is running: its descendant shells
    started through ~/.claude/shell-snapshots/. None where /proc is missing."""
    if not os.path.isdir("/proc"):
        return None
    pid = int(session.get("pid", 0) or 0)
    marker = os.path.join(claude_dir(session), "shell-snapshots") + os.sep
    count, stack, seen = 0, [pid], set()
    while stack:
        current = stack.pop()
        for children in glob.glob(f"/proc/{current}/task/*/children"):
            try:
                with open(children) as f:
                    stack.extend(int(c) for c in f.read().split() if int(c) not in seen)
            except (OSError, ValueError):
                continue
        if current == pid:
            continue
        seen.add(current)
        try:
            with open(f"/proc/{current}/cmdline", "rb") as f:
                if marker.encode() in f.read():
                    count += 1
        except OSError:
            pass
    return count


def short_name(session):
    """The session name without its project's name, which the heading
    already shows ("rigtop-06" under "rigtop" becomes "06")."""
    name = session.get("name") or "main"
    project = os.path.basename(session.get("cwd", "").rstrip("/\\"))
    if project and name.startswith(project + "-") and len(name) > len(project) + 1:
        return name[len(project) + 1 :]
    return name


def session_line(session, agents, now):
    """(label, text, level, rank) for a session: what it is doing, and for
    an idle one how long and whether it waits for you or for background
    work, and for a busy one how long it has been at it. `rank` orders
    sessions: working ones first (busy, or with background work), the
    longest at it first; then those waiting for you (a permission prompt or
    a reply alike), most recent first. None when the session is to be left
    out."""
    status = session.get("status", "?")
    name = short_name(session)
    since = status_since(session)
    waited = now - since if since else 0
    elapsed = f" · {duration(waited)}" if since else ""
    # Waiting for you: yellow while fresh, then grey, then left out.
    if HIDE_SECS and waited > HIDE_SECS:
        stale_level = None
    else:
        stale_level = "dim" if waited > FRESH_SECS else "warn"
    if status == "busy":
        extra = f" · {len(agents)} agent{'s' if len(agents) != 1 else ''}" if agents else ""
        return status, f"{name}{extra}{elapsed}", "ok", (0, -waited)
    if status == "waiting":
        what = session.get("waitingFor") or "you"
        # Yellow and kept however long: it cannot go on without you.
        return status, f"{name} · needs {what}{elapsed}", "warn", (1, waited)
    if status == "idle":
        commands = running_commands(session) or 0
        pending = []
        if commands:
            pending.append(f"{commands} task{'s' if commands != 1 else ''}")
        if agents:
            pending.append(f"{len(agents)} agent{'s' if len(agents) != 1 else ''}")
        if pending:
            # Its turn ended, but background work it started still runs.
            return status, f"{name} · waiting on {', '.join(pending)}{elapsed}", "ok", (0, -waited)
        if stale_level is None:
            return None
        return status, f"{name} · your turn{elapsed}", stale_level, (1, waited)
    return status, name, "normal", (2, 0)


def session_rows(now):
    found = sessions()
    if not found:
        return [row("no running sessions", level="dim")]
    listed, hidden = [], 0
    for session in found:
        agents = active_subagents(session, now)
        line = session_line(session, agents, now)
        if line is None:
            hidden += 1
            continue
        label, text, level, rank = line
        listed.append((rank, session.get("startedAt", 0), session, agents, label, text, level))
    listed.sort(key=lambda item: item[:2])
    # A project's name: yellow while one of its sessions waits for you,
    # else green while one works, grey when all are left waiting.
    priority = {"warn": 0, "ok": 1, "normal": 2, "dim": 3}
    project_level = {}
    for *_, session, _, _, _, level in listed:
        cwd = session.get("cwd", "")
        current = project_level.get(cwd, "dim")
        project_level[cwd] = min(current, level, key=priority.__getitem__)
    rows = []
    previous = None
    for _, _, session, agents, label, text, level in listed:
        # The project's name above its sessions, again where the order
        # moves on to another project and back.
        cwd = session.get("cwd", "")
        if cwd != previous:
            name = os.path.basename(cwd.rstrip("/\\")) or "?"
            rows.append(row(name, heading=True, level=project_level[cwd]))
            previous = cwd
        # With several accounts, which one the session runs on.
        account = {"hint": f"account {session['_account']}"} if session.get("_account") else {}
        rows.append(
            row(text, label=STATUS_INDENT + label, level=level, label_level=level, **account)
        )
        # A session left waiting for a while keeps to one line.
        context = context_row(session, level) if level != "dim" else None
        if context:
            rows.append(context)
        for age, kind, description in agents:
            text = f"{kind}: {description}" if description else kind
            agent_level = level if age < 30 else "dim"
            rows.append(
                row(text, label=CHILD_INDENT + "agent", level=agent_level, label_level=agent_level)
            )
    if hidden:
        rows.append(row(f"+{hidden} idle over {duration(HIDE_SECS)}", level="dim"))
    return rows or [row("no running sessions", level="dim")]


def main():
    now = time.time()
    # A line between the usage limits and the sessions.
    rows = limit_rows(now) + [row(separator=True)] + session_rows(now)
    json.dump({"rows": rows}, sys.stdout, ensure_ascii=False)
    print()


if __name__ == "__main__":
    main()
