<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSIX package for the Microsoft Store. build.ps1 fills in the @…@
  values: the identity comes from Partner Center (Product identity), the
  version from Cargo.toml, the architecture from the build.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop4 rescap">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="@ARCH@" />

  <Properties>
    <DisplayName>rigtop</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- Windows 11 (what it is made and tested for). -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- The app's language (its screens are in English only). -->
  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <!-- One application (the Store takes no more per package): the GUI, in the Start
       menu. Its one execution alias (an application may have only one) makes the
       terminal version, a console program, the command `rigtop` in a terminal.
       Several may run at once (terminals, agents for remote monitoring), which a
       console alias requires anyway.
       (No double hyphens in XML comments.) -->
  <Applications>
    <Application Id="rigtop" Executable="rigtop-gui.exe" EntryPoint="Windows.FullTrustApplication"
      desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="rigtop"
        Description="A system monitor for this PC and others over SSH"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="rigtop.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="rigtop.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A desktop (Win32) app: system-wide performance data and processes, ending
         processes, NVML, running ssh.exe and widget commands. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
