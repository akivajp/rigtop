pkgbase = rigtop
	pkgdesc = System monitor for workstations, laptops and NAS (TUI and native GUI), a btop alternative with storage health, GPU usage and many hosts over SSH
	pkgver = 0.10.0
	pkgrel = 1
	url = https://github.com/akivajp/rigtop
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
