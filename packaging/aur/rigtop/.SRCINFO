pkgbase = rigtop
	pkgdesc = System monitor for workstations, laptops and NAS (TUI and native GUI), a btop alternative with storage health, GPU usage and many hosts over SSH
	pkgver = 0.11.0
	pkgrel = 1
	url = https://github.com/akivajp/rigtop
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	makedepends = cargo
	depends = gcc-libs
	depends = glibc
	depends = libxkbcommon
	depends = vulkan-icd-loader
	depends = wayland
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxrandr
	optdepends = smartmontools: SMART data (set up with sudo rigtop --install-collector)
	optdepends = iw: Wi-Fi signal and link rate
	optdepends = nvidia-utils: NVIDIA GPUs
	optdepends = openssh: monitoring remote hosts
	options = !lto
