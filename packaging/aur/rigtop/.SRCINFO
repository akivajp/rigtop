	depends = gcc-libs
	depends = glibc
	depends = libxkbcommon
	depends = vulkan-icd-loader
	depends = wayland
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxrandr
	optdepends = smartmontools: SMART data (set up with sudo rigtop --install-collector)
	optdepends = iw: Wi-Fi signal and link rate
	optdepends = nvidia-utils: NVIDIA GPUs
	optdepends = openssh: monitoring remote hosts
	options = !lto
